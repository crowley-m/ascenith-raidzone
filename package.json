{
  "name": "ascenith-raidzone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/bot/tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "bot": "tsx src/bot/index.ts",
    "bot:deploy-commands": "tsx src/bot/deploy-commands.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.7.4",
    "@prisma/client": "6.3.0",
    "date-fns": "4.1.0",
    "discord.js": "14.17.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.11",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.25",
    "prisma": "6.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.33.5",
    "tsx": "4.19.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.1",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
