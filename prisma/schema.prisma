// ASCENITH RAIDZONE — data model
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js) — identity only
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime? // kept for the Auth.js Prisma adapter
  name          String?
  image         String?

  discordId       String? @unique
  discordUsername String?
  discordAvatar   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  player    Player?
  staffRole StaffRole?

  authoredNotes StaffNote[] @relation("NoteAuthor")
  authoredFlags Flag[]      @relation("FlagAuthor")
  createdEvents Event[]     @relation("EventCreator")
  markedAttend  EventAttendance[] @relation("AttendanceMarker")
  grantedReward Reward[]    @relation("RewardGranter")
  auditLogs     AuditLog[]
  createdMedia  MediaAsset[] @relation("MediaCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Community
// ---------------------------------------------------------------------------

enum PlayerStatus {
  PENDING
  ACTIVE
  INACTIVE
  BANNED
}

enum Platform {
  PC
  PLAYSTATION
  XBOX
}

model Player {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Once Human identity
  characterName String?
  gameUid       String? // in-game UID of the main character — where rewards are sent
  platform      Platform?
  region        String? // server / world / region

  // Contact & scheduling
  timezone  String?
  playHours String?
  languages String?

  // Community
  status         PlayerStatus @default(ACTIVE)
  factionId      String?
  faction        Faction?     @relation(fields: [factionId], references: [id], onDelete: SetNull)
  joinedAt       DateTime     @default(now())
  dmNotifications Boolean     @default(true) // Discord DMs for waitlist / start / rewards

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signups       EventSignup[]
  attendance    EventAttendance[]
  rewards       Reward[]
  notes         StaffNote[]
  flags         Flag[]
  placements    EventPlacement[]
  participation EventParticipation[]

  teamsLed        Team[]       @relation("TeamLeader")
  teamMemberships TeamMember[]

  @@index([status])
  @@index([factionId])
}

// ---------------------------------------------------------------------------
// Teams — player-made squads, one per team event (distinct from staff Factions).
// A player can lead / be in a different team for every event, but only one per
// event.
// ---------------------------------------------------------------------------

model Team {
  id         String   @id @default(cuid())
  name       String
  tag        String?
  inviteCode String   @unique
  leaderId   String
  leader     Player   @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  eventId    String // the event this squad is formed for
  event      Event    @relation("TeamsForEvent", fields: [eventId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  discordRoleId         String? // team's access role for its private voice channel
  discordVoiceChannelId String?

  members    TeamMember[]
  signups    EventSignup[]
  placements EventPlacement[]

  @@unique([eventId, name])
  @@index([leaderId])
  @@index([eventId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, playerId])
  @@index([teamId])
  @@index([playerId])
}

model Faction {
  id            String   @id @default(cuid())
  name          String   @unique
  tag           String?
  color         String? // hex
  description   String?
  discordRoleId String? // Discord role granted to members of this faction
  createdAt     DateTime @default(now())

  players Player[]
}

model StaffRole {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role
  createdAt DateTime @default(now())
}

enum Role {
  OWNER
  ADMIN
  MODERATOR
}

model StaffNote {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([playerId])
}

enum FlagType {
  NOTE
  WARNING
  BAN
}

model Flag {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("FlagAuthor", fields: [authorId], references: [id])
  type      FlagType @default(NOTE)
  reason    String
  createdAt DateTime @default(now())

  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

enum SeasonStatus {
  UPCOMING
  ACTIVE
  ENDED
}

// A competitive season within a tournament series (e.g. "Duo-Squad
// Tournament — Season 3"). Events roll up into one; each has its own page
// with match videos. Editable in the portal.
model Season {
  id            String       @id @default(cuid())
  series        String       @default("Duo-Squad Tournament")
  number        Int
  slug          String       @unique // URL — e.g. "duo-squad-3", "faction-war-1"
  name          String? // optional subtitle, e.g. "Ascension"
  status        SeasonStatus @default(UPCOMING)
  startsAt      DateTime?
  endsAt        DateTime?
  prizePoolText String? // "101,450 Crystgin"
  championName  String? // "SCUBACAT" / "FSQ Team" — blank until crowned
  championNote  String? // free line under the name, optional
  posterUrl     String? // /media/champion-season-3.webp or /api/media/<id>
  blurb         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
  videos SeasonVideo[]

  @@unique([series, number])
  @@index([status])
}

model SeasonVideo {
  id        String  @id @default(cuid())
  seasonId  String
  season    Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  sortOrder Int     @default(0)

  @@index([seasonId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum SignupState {
  SIGNED_UP
  WAITLIST
  WITHDRAWN
}

enum EventFormat {
  SOLO
  TEAM
}

model Event {
  id             String      @id @default(cuid())
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  timezone       String? // IANA zone the start/end wall-clock times were entered in
  server         String? // which custom server / world
  format         EventFormat @default(SOLO)
  maxSlots       Int? // SOLO: max players · TEAM: max teams
  teamSize       Int? // TEAM: players counted per team (optional cap)
  rewardPoolText String?
  status         EventStatus @default(DRAFT)

  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  // landing / public brief
  summary     String? // 1-2 line teaser for the landing card
  mode        String? // e.g. "PURGE" — shown next to RAIDZONE
  wipeCycle   String? // e.g. "2 weeks"
  raidWindow  String? // e.g. "15:30 – 21:29 · 6 hrs/day"
  rewardTiers Json? // [{ "place": "1st", "reward": "30K Crystgin" }, ...]
  bonusText   String? // e.g. "20K Crystgin · hidden across airdrops, cards, alpha boss"
  rulesMd     String? // markdown rules for this event (shown on the page + Discord)
  detailsMd   String? // full markdown brief shown on /events/[id]
  howToJoinVideoUrl String? // YouTube link — plays on the event page + the landing (when featured)
  announcePing    Boolean @default(false) // ping @everyone when the announcement posts
  announcePingAll Boolean @default(false) // ping @everyone in every event channel, not just announcement

  // per-Discord-channel content (posted to the event's channels)
  announcementMd String?
  howToJoinMd    String?
  gameplayMd     String?
  wipeInfoMd     String?
  rewardsMd      String? // overrides the auto reward-tier post if set

  discordMessageId    String?
  discordChannelId    String?
  discordCategoryId   String? // event's Discord category, once the bot builds it
  discordChannels     Json? // { announcement: "id", rules: "id", ... }
  discordSeedMessages Json? // { announcement: "messageId", ... } — for re-sync
  discordRoleId       String? // per-event access role — granted on sign-up, deleted on archive
  discordArchivedAt   DateTime? // when the space was archived (renamed + sunk)
  reminderSentAt      DateTime? // when the bot posted the "starts soon" reminder

  createdById String
  createdBy   User   @relation("EventCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signups       EventSignup[]
  attendance    EventAttendance[]
  rewards       Reward[]
  placements    EventPlacement[]
  teamsFor      Team[]               @relation("TeamsForEvent")
  bracket       Bracket?
  participation EventParticipation[]

  @@index([status, startsAt])
  @@index([seasonId])
}

// Permanent "played in this event" record — kept when the event / Discord role
// is deleted. Written on archive from whoever held the event's access role.
model EventParticipation {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  eventName String // snapshot
  eventMode String? // snapshot
  playedAt  DateTime // event start, snapshot
  createdAt DateTime @default(now())

  @@unique([eventId, playerId])
  @@index([playerId])
}

model EventPlacement {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rank      Int // 1 = 1st, 2 = 2nd, ...
  teamId    String? // set for TEAM events
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  playerId  String? // set for SOLO events
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([eventId, rank])
  @@index([eventId])
}

model EventSignup {
  id        String      @id @default(cuid())
  eventId   String
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId    String? // set on TEAM-format events
  team      Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  state     SignupState @default(SIGNED_UP)
  createdAt DateTime    @default(now())

  @@unique([eventId, playerId])
  @@index([eventId])
  @@index([eventId, teamId])
}

model EventAttendance {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  attended  Boolean  @default(true)
  markedById String
  markedBy   User     @relation("AttendanceMarker", fields: [markedById], references: [id])
  markedAt  DateTime @default(now())

  @@unique([eventId, playerId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Tournament bracket — single elimination, one per event
// ---------------------------------------------------------------------------

model Bracket {
  id        String         @id @default(cuid())
  eventId   String         @unique
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  size      Int // 2 · 4 · 8 · 16 · 32 — round-1 slot count
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  matches   BracketMatch[]
}

model BracketMatch {
  id          String  @id @default(cuid())
  bracketId   String
  bracket     Bracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  round       Int // 1 = first round
  position    Int // 0-based within the round
  aRef        String? // "team:<id>" | "player:<id>"
  bRef        String?
  winner      String? // "a" | "b"
  aScore      Int?
  bScore      Int?
  nextMatchId String? // the match this winner advances into
  nextSlot    String? // "a" | "b"

  @@unique([bracketId, round, position])
  @@index([bracketId])
}

// ---------------------------------------------------------------------------
// Rewards
// ---------------------------------------------------------------------------

model Reward {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  item         String
  amount       String?
  reason       String
  isPublic     Boolean  @default(false)
  proofImageUrl String?
  proofImageId String?
  proofImage   MediaAsset? @relation(fields: [proofImageId], references: [id], onDelete: SetNull)
  grantedById  String
  grantedBy    User     @relation("RewardGranter", fields: [grantedById], references: [id])
  grantedAt    DateTime @default(now())
  receivedAt   DateTime? // set by the player when they confirm it arrived in-game

  @@index([playerId])
  @@index([isPublic, grantedAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Owner-editable settings (bot behaviour, invite link, channel template …).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Media — image uploads (gallery stills, reward proof). Bytes live in the DB
// so there's no upload volume to manage; served via /api/media/[id].
// ---------------------------------------------------------------------------

// A titled image section on the public Winners page. Built-ins ("gallery",
// "proof", "reward") are not stored here — these are the extra staff-made ones.
model MediaCollection {
  id        String   @id @default(cuid())
  slug      String   @unique // MediaAsset.kind for its images
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model MediaAsset {
  id          String   @id @default(cuid())
  kind        String // "gallery" | "proof" | "reward" | a MediaCollection slug
  data        Bytes
  contentType String
  bytes       Int
  width       Int?
  height      Int?
  caption     String? // gallery: the big label (e.g. "PURGE 04")
  tag         String? // gallery: the small label (e.g. "base hold")
  sortOrder   Int      @default(0)
  createdById String?
  createdBy   User?    @relation("MediaCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  rewards Reward[]

  @@index([kind, sortOrder])
}
